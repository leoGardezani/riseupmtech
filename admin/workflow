<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Roadmap — Rise Up & Jogo</title>
<style>
  :root {
    --bg: #f7f7f5;
    --card: #ffffff;
    --border: #e2e0d9;
    --text-primary: #1c1c1a;
    --text-secondary: #6b6a63;
    --text-muted: #9c9a92;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 40px 24px 80px;
    background: var(--bg);
    color: var(--text-primary);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  }
  .wrap { max-width: 920px; margin: 0 auto; }
  h1 { font-size: 22px; font-weight: 600; margin: 0 0 4px; }
  .subtitle { font-size: 14px; color: var(--text-secondary); margin: 0 0 24px; }

  .toolbar {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    padding: 10px 14px; margin-bottom: 24px; font-size: 13px;
  }
  .toolbar label { color: var(--text-secondary); display: flex; align-items: center; gap: 6px; }
  .toolbar input[type="number"] { width: 54px; padding: 4px 6px; border: 1px solid var(--border); border-radius: 6px; }
  .toolbar button {
    border: 1px solid var(--border); background: #fff; border-radius: 6px;
    padding: 6px 12px; cursor: pointer; font-size: 13px; color: var(--text-primary);
  }
  .toolbar button:hover { background: #f0efe9; }

  .section {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px 24px 24px;
    margin-bottom: 24px;
  }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
  .section h2 { font-size: 16px; font-weight: 600; margin: 0; }
  .section .cadence { font-size: 12.5px; color: var(--text-secondary); margin: 0 0 16px; }

  .add-row { display: flex; gap: 6px; margin-bottom: 16px; flex-wrap: wrap; }
  .add-row input[type="text"] {
    flex: 1; min-width: 140px; padding: 6px 8px; border: 1px solid var(--border); border-radius: 6px; font-size: 13px;
  }
  .add-row input[type="number"] { width: 58px; padding: 6px 6px; border: 1px solid var(--border); border-radius: 6px; font-size: 13px; }
  .add-row input[type="color"] { width: 34px; height: 32px; padding: 2px; border: 1px solid var(--border); border-radius: 6px; }
  .add-row button {
    border: none; background: var(--text-primary); color: #fff; border-radius: 6px;
    padding: 6px 14px; cursor: pointer; font-size: 13px;
  }
  .add-row button:hover { opacity: 0.85; }

  .header-row { display: flex; margin-bottom: 6px; }
  .header-spacer { width: 200px; flex-shrink: 0; }
  .header-weeks { flex: 1; display: flex; position: relative; }
  .header-weeks span {
    flex: 1; text-align: center; font-size: 11px; color: var(--text-muted);
    border-left: 1px dashed var(--border);
  }

  .task-row { display: flex; align-items: center; margin-bottom: 6px; }
  .task-label {
    width: 200px; flex-shrink: 0; font-size: 12.5px; color: var(--text-secondary);
    padding: 4px 10px 4px 0; outline: none; cursor: text; border-radius: 4px;
  }
  .task-label:focus { background: #f0efe9; }
  .track {
    flex: 1; position: relative; height: 30px; background: repeating-linear-gradient(
      to right, transparent, transparent calc(100%/8 - 1px), var(--border) calc(100%/8 - 1px), var(--border) calc(100%/8)
    );
    border-radius: 4px;
  }
  .bar {
    position: absolute; top: 2px; height: 26px; border-radius: 5px;
    display: flex; align-items: center; padding: 0 8px; font-size: 11px; color: #fff;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    cursor: grab; user-select: none;
  }
  .bar:active { cursor: grabbing; }
  .bar .handle {
    position: absolute; right: 0; top: 0; width: 8px; height: 100%;
    cursor: ew-resize; background: rgba(255,255,255,0.25);
  }
  .bar .del {
    position: absolute; left: 100%; margin-left: 6px; top: 50%; transform: translateY(-50%);
    width: 16px; height: 16px; border-radius: 50%; background: var(--border);
    color: var(--text-secondary); font-size: 11px; line-height: 16px; text-align: center;
    cursor: pointer; opacity: 0; transition: opacity .15s;
  }
  .task-row:hover .del { opacity: 1; }

  .hint { font-size: 11.5px; color: var(--text-muted); margin-top: 14px; }

  @media (max-width: 640px) {
    .header-spacer, .task-label { width: 120px; }
  }
</style>
</head>
<body>
  <div class="wrap">
    <h1>Roadmap — Rise Up & Jogo</h1>
    <p class="subtitle">Arraste as barras pra mover, puxe a borda direita pra redimensionar, clique no texto pra editar. Mexer numa tarefa empurra automaticamente as tarefas seguintes da mesma seção (a ordem de cima pra baixo é a cadeia de dependência). Tudo salva automaticamente neste navegador.</p>

    <div class="toolbar">
      <label>Semanas visíveis <input type="number" id="totalWeeks" value="8" min="4" max="26"></label>
      <button id="resetBtn">Restaurar exemplo</button>
      <button id="exportBtn">Exportar JSON</button>
    </div>

    <div class="section" data-project="riseup">
      <div class="section-head"><h2>Rise Up — retomada da automação</h2></div>
      <p class="cadence">Planilha → BigQuery → plataformas de mídia → site · ritmo Seg+Ter</p>

      <div class="add-row">
        <input type="text" class="new-name" placeholder="Nova tarefa...">
        <input type="number" class="new-start" placeholder="início (sem)" value="1" min="0">
        <input type="number" class="new-dur" placeholder="duração (sem)" value="1" min="0.5" step="0.5">
        <input type="color" class="new-color" value="#1D9E75">
        <button class="add-btn">Adicionar</button>
      </div>

      <div class="header-row">
        <div class="header-spacer"></div>
        <div class="header-weeks"></div>
      </div>
      <div class="rows"></div>
    </div>

    <div class="section" data-project="jogo">
      <div class="section-head"><h2>Jogo — vertical slice</h2></div>
      <p class="cadence">Mecânica → conteúdo → validação → itch.io · ritmo Qui+Sex</p>

      <div class="add-row">
        <input type="text" class="new-name" placeholder="Nova tarefa...">
        <input type="number" class="new-start" placeholder="início (sem)" value="1" min="0">
        <input type="number" class="new-dur" placeholder="duração (sem)" value="1" min="0.5" step="0.5">
        <input type="color" class="new-color" value="#D85A30">
        <button class="add-btn">Adicionar</button>
      </div>

      <div class="header-row">
        <div class="header-spacer"></div>
        <div class="header-weeks"></div>
      </div>
      <div class="rows"></div>
    </div>

    <p class="hint">Os dados ficam salvos no localStorage deste navegador/domínio. Use "Exportar JSON" pra guardar uma cópia ou mover pra outro navegador.</p>
  </div>

<script>
const STORAGE_KEY = 'riseup_roadmap_v1';

const defaultTasks = [
  { id: 1, project: 'riseup', name: 'Diagnóstico + template de planilha', start: 0, dur: 2, color: '#5DCAA5' },
  { id: 2, project: 'riseup', name: 'Alimentação do BigQuery', start: 1, dur: 3, color: '#1D9E75' },
  { id: 3, project: 'riseup', name: 'Integração com plataformas de mídia', start: 4, dur: 3, color: '#0F6E56' },
  { id: 4, project: 'riseup', name: 'Validação do supermetrics interno', start: 6, dur: 2, color: '#0F6E56' },
  { id: 5, project: 'riseup', name: 'Reintegração com o site', start: 7, dur: 1, color: '#085041' },
  { id: 6, project: 'jogo', name: 'Prototipagem da mecânica core (fone/sanidade)', start: 0, dur: 2, color: '#F0997B' },
  { id: 7, project: 'jogo', name: 'Vertical slice: arte + level design', start: 1, dur: 3, color: '#D85A30' },
  { id: 8, project: 'jogo', name: 'Áudio e trilha inicial', start: 4, dur: 2, color: '#993C1D' },
  { id: 9, project: 'jogo', name: 'Playtest interno e ajustes', start: 5, dur: 2, color: '#993C1D' },
  { id: 10, project: 'jogo', name: 'Publicação de protótipo no itch.io', start: 6, dur: 2, color: '#712B13' },
];

let tasks = loadTasks();
let totalWeeks = 8;
let nextId = Math.max(0, ...tasks.map(t => t.id)) + 1;
const barRegistry = {}; // task.id -> { bar, track } DOM refs, used to cascade downstream bars during drag

function loadTasks() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) return JSON.parse(raw);
  } catch (e) {}
  return JSON.parse(JSON.stringify(defaultTasks));
}

function saveTasks() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(tasks)); } catch (e) {}
}

function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }
function snap(v) { return Math.round(v * 2) / 2; }

function renderHeader(container) {
  container.innerHTML = '';
  for (let i = 1; i <= totalWeeks; i++) {
    const s = document.createElement('span');
    s.textContent = 'S' + i;
    container.appendChild(s);
  }
}

function renderProject(project) {
  const section = document.querySelector(`.section[data-project="${project}"]`);
  const rowsEl = section.querySelector('.rows');
  const headerWeeks = section.querySelector('.header-weeks');
  renderHeader(headerWeeks);
  rowsEl.innerHTML = '';

  const projectTasks = tasks.filter(t => t.project === project);
  projectTasks.forEach(task => {
    const row = document.createElement('div');
    row.className = 'task-row';

    const label = document.createElement('div');
    label.className = 'task-label';
    label.contentEditable = 'true';
    label.textContent = task.name;
    label.addEventListener('blur', () => {
      task.name = label.textContent.trim() || task.name;
      saveTasks();
    });
    label.addEventListener('keydown', e => {
      if (e.key === 'Enter') { e.preventDefault(); label.blur(); }
    });

    const track = document.createElement('div');
    track.className = 'track';

    const bar = document.createElement('div');
    bar.className = 'bar';
    bar.style.background = task.color;
    bar.textContent = task.name;

    const handle = document.createElement('div');
    handle.className = 'handle';
    bar.appendChild(handle);

    const del = document.createElement('div');
    del.className = 'del';
    del.textContent = '×';
    del.addEventListener('click', () => {
      tasks = tasks.filter(t => t.id !== task.id);
      saveTasks();
      renderProject(project);
    });
    bar.appendChild(del);

    track.appendChild(bar);
    row.appendChild(label);
    row.appendChild(track);
    rowsEl.appendChild(row);

    barRegistry[task.id] = { bar, track };
    positionBar(bar, track, task);
    attachDrag(bar, track, task, project);
  });
}

function positionBar(bar, track, task) {
  const trackWidth = track.clientWidth;
  const weekWidth = trackWidth / totalWeeks;
  bar.style.left = (task.start * weekWidth) + 'px';
  bar.style.width = Math.max(task.dur * weekWidth - 2, 20) + 'px';
}

function attachDrag(bar, track, task, project) {
  let mode = null; // 'move' | 'resize'
  let startX = 0;
  let startLeft = 0;
  let startDur = 0;
  let downstream = []; // tasks after this one in the same project's list, captured at drag start

  function captureDownstream() {
    const projectTasks = tasks.filter(t => t.project === project);
    const idx = projectTasks.findIndex(t => t.id === task.id);
    downstream = projectTasks.slice(idx + 1).map(t => ({ ref: t, originalStart: t.start }));
  }

  bar.addEventListener('mousedown', e => {
    if (e.target.classList.contains('handle') || e.target.classList.contains('del')) return;
    mode = 'move';
    startX = e.clientX;
    startLeft = task.start;
    captureDownstream();
    e.preventDefault();
  });

  bar.querySelector('.handle').addEventListener('mousedown', e => {
    mode = 'resize';
    startX = e.clientX;
    startDur = task.dur;
    captureDownstream();
    e.preventDefault();
    e.stopPropagation();
  });

  document.addEventListener('mousemove', e => {
    if (!mode) return;
    const weekWidth = track.clientWidth / totalWeeks;
    const deltaWeeks = (e.clientX - startX) / weekWidth;
    let effectiveDelta = 0;
    if (mode === 'move') {
      const newStart = clamp(snap(startLeft + deltaWeeks), 0, totalWeeks - task.dur);
      effectiveDelta = newStart - startLeft;
      task.start = newStart;
    } else if (mode === 'resize') {
      const newDur = clamp(snap(startDur + deltaWeeks), 0.5, totalWeeks - task.start);
      effectiveDelta = newDur - startDur;
      task.dur = newDur;
    }
    positionBar(bar, track, task);

    // cascade: push every downstream task by the same delta, keeping the gaps between them
    downstream.forEach(d => {
      d.ref.start = clamp(d.originalStart + effectiveDelta, 0, totalWeeks - d.ref.dur);
      const refs = barRegistry[d.ref.id];
      if (refs) positionBar(refs.bar, refs.track, d.ref);
    });
  });

  document.addEventListener('mouseup', () => {
    if (mode) { saveTasks(); }
    mode = null;
    downstream = [];
  });
}

function renderAll() {
  renderProject('riseup');
  renderProject('jogo');
}

document.getElementById('totalWeeks').addEventListener('change', e => {
  totalWeeks = clamp(parseInt(e.target.value) || 8, 4, 26);
  renderAll();
});

document.getElementById('resetBtn').addEventListener('click', () => {
  if (!confirm('Restaurar o roadmap para o exemplo original? Isso apaga suas edições.')) return;
  tasks = JSON.parse(JSON.stringify(defaultTasks));
  nextId = Math.max(0, ...tasks.map(t => t.id)) + 1;
  saveTasks();
  renderAll();
});

document.getElementById('exportBtn').addEventListener('click', () => {
  const blob = new Blob([JSON.stringify(tasks, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'roadmap.json';
  a.click();
  URL.revokeObjectURL(url);
});

document.querySelectorAll('.section').forEach(section => {
  const project = section.dataset.project;
  section.querySelector('.add-btn').addEventListener('click', () => {
    const nameInput = section.querySelector('.new-name');
    const startInput = section.querySelector('.new-start');
    const durInput = section.querySelector('.new-dur');
    const colorInput = section.querySelector('.new-color');
    const name = nameInput.value.trim();
    if (!name) return;
    tasks.push({
      id: nextId++,
      project,
      name,
      start: clamp(parseFloat(startInput.value) || 0, 0, totalWeeks - 0.5),
      dur: clamp(parseFloat(durInput.value) || 1, 0.5, totalWeeks),
      color: colorInput.value,
    });
    nameInput.value = '';
    saveTasks();
    renderProject(project);
  });
});

window.addEventListener('resize', renderAll);
renderAll();
</script>
</body>
</html>
